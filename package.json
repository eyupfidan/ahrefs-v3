{
  "name": "ahrefs-v3",
  "version": "1.1.0",
  "description": "A type-friendly universal JavaScript client for the Ahrefs API v3 endpoints.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/write-esm-package.cjs",
    "test": "npm run build && node --test test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyupfidan/ahrefs-v3.git"
  },
  "keywords": [
    "ahrefs",
    "api",
    "v3",
    "seo",
    "analysis",
    "data",
    "browser",
    "react",
    "vue",
    "frontend"
  ],
  "author": "Eyüp Fidan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eyupfidan/ahrefs-v3/issues"
  },
  "homepage": "https://github.com/eyupfidan/ahrefs-v3#readme",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  }
}
